VITE_API_URL=http://localhost:3000

# Firebase Authentication (Web SDK Modular — sem credenciais reais versionadas)
VITE_FIREBASE_API_KEY=substitua-pela-web-api-key-do-firebase
VITE_FIREBASE_AUTH_DOMAIN=fono-dev-local.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=fono-dev-local
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
# Opcional em desenvolvimento/testes locais para apontar ao Firebase Auth Emulator (ex.: http://127.0.0.1:9099)
VITE_FIREBASE_AUTH_EMULATOR_URL=
