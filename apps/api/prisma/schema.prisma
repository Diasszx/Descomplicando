datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  PROFISSIONAL
  PACIENTE
  AUTONOMO
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// Modelagem inicial para validação de conexões e migrations no CI
model SystemHealthCheck {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
  status    String   @default("ok")

  @@map("system_health_checks")
}

model User {
  id                        String           @id @default(uuid())
  firebaseUid               String?          @unique @map("firebase_uid")
  name                      String
  email                     String           @unique
  emailVerified             Boolean          @default(false) @map("email_verified")
  role                      UserRole         @default(AUTONOMO)
  status                    UserStatus       @default(ACTIVE)
  mustChangePassword        Boolean          @default(false) @map("must_change_password")
  passwordChangedAt         DateTime?        @map("password_changed_at")
  mfaEnabled                Boolean          @default(false) @map("mfa_enabled")
  mfaSecretEncrypted        String?          @map("mfa_secret_encrypted")
  mfaPendingSecretEncrypted String?          @map("mfa_pending_secret_encrypted")
  mfaEnrolledAt             DateTime?        @map("mfa_enrolled_at")
  mfaLastUsedStep           Int?             @map("mfa_last_used_step")
  lastLoginAt               DateTime?        @map("last_login_at")
  deletedAt                 DateTime?        @map("deleted_at")
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  mfaSessions               UserMfaSession[]

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model UserMfaSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  firebaseAuthTime Int       @map("firebase_auth_time")
  verifiedAt       DateTime  @default(now()) @map("verified_at")
  revokedAt        DateTime? @map("revoked_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, firebaseAuthTime])
  @@index([userId, revokedAt])
  @@map("user_mfa_sessions")
}
