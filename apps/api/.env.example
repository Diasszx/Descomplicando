PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fono?schema=public
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Firebase Authentication (Admin SDK — Service Account sem segredos versionados)
FIREBASE_PROJECT_ID=fono-dev-local
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@fono-dev-local.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="substitua-pela-private-key-do-firebase-com-quebras-de-linha-escapadas"
# Opcional em desenvolvimento/testes locais para usar o Firebase Auth Emulator (ex.: 127.0.0.1:9099)
FIREBASE_AUTH_EMULATOR_HOST=

# Chave simétrica de 32 bytes (64 caracteres hex ou 32 bytes em base64) para cifragem AES-256-GCM dos segredos TOTP
MFA_ENCRYPTION_KEY=substitua-por-chave-de-32-bytes-em-hex-ou-base64
