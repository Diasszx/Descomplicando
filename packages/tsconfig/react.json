{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React Strict TypeScript Config",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": false,
    "noEmit": true
  }
}
